# =========================================================
# ORION - EXEMPLO DE CONFIGURAÇÃO
# =========================================================
# Copie este arquivo para ".env" e altere apenas o necessário.
# Nunca envie o arquivo .env real para o GitHub.


# Caminhos
# Deixe vazio para usar automaticamente a pasta do projeto.
ORION_HOME=


# Áudio
# Deixe vazio para usar o dispositivo padrão do sistema.
AUDIO_INPUT_DEVICE=

SILENCIO_LIMIAR_AUDIO=0.005
SILENCIO_SEGUNDOS_AUTO_STOP=0.6
GRAVACAO_AUTO_MAX_SEGUNDOS=6.0
GRAVACAO_AUTO_MIN_SEGUNDOS=0.6


# Ativação
# Valores: manual ou wakeword
MODO_ATIVACAO=wakeword

WAKEWORD_ENGINE=openwakeword
OPENWAKEWORD_MODEL=hey_jarvis
OPENWAKEWORD_THRESHOLD=0.15
OPENWAKEWORD_BLOCK_SAMPLES=1280
WAKEWORD_COOLDOWN_SEGUNDOS=3.0


# Spotify
# Use suas próprias credenciais do Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback


# Roku TV
# Configure apenas se desejar utilizar a integração com Roku.
ROKU_TV_IP=
ROKU_TV_PORT=8060
